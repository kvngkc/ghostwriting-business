# Copy to .env and fill in. Never commit .env.

# Claude API key from console.anthropic.com (or use `ant auth login` instead)
ANTHROPIC_API_KEY=

# n8n
TIMEZONE=Africa/Lagos
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Postiz (copied into the official Postiz compose file by setup-postiz.sh)
POSTIZ_URL=http://localhost:4007
# Generate with: openssl rand -hex 32
POSTIZ_JWT_SECRET=
# From your LinkedIn developer app (Products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
